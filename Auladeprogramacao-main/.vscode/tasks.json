{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Gravity 3D: iniciar servidor local",
            "type": "process",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "5500",
                "--bind",
                "127.0.0.1",
                "--directory",
                "${fileDirname}"
            ],
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": {
                "owner": "gravity3d-server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving HTTP on",
                    "endsPattern": "^Serving HTTP on .*port 5500"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": false
            }
        }
    ]
}
