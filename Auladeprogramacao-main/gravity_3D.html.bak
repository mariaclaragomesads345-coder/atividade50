<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gravity 3D - Particle Universe</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { overflow: hidden; background: #000; font-family: Arial, sans-serif; color: white; }
        canvas { display: block; }
        #painel {
            position: absolute; z-index: 1; top: 20px; left: 20px; padding: 18px;
            background: rgba(5, 8, 20, 0.65); border: 1px solid rgba(100, 150, 255, 0.2);
            border-radius: 12px; backdrop-filter: blur(10px); min-width: 210px;
        }
        h2 { color: #ffe17a; font-size: 19px; margin-bottom: 12px; }
        .info { color: #c5d3ed; font-size: 13px; line-height: 1.9; }
        .valor { color: #fff; font-weight: bold; }
        .acoes { display: flex; gap: 8px; margin-top: 12px; }
        button {
            border: 1px solid rgba(150, 180, 255, 0.35); border-radius: 6px;
            padding: 8px 10px; color: white; background: #354d85; cursor: pointer;
        }
        button:hover { background: #4967aa; }
        button:focus-visible { outline: 2px solid #ffe17a; outline-offset: 2px; }
        #ajuda {
            position: absolute; z-index: 1; bottom: 20px; left: 20px; color: #aab5ca;
            font-size: 12px; line-height: 1.8; background: rgba(0, 0, 0, 0.5);
            padding: 10px; border-radius: 8px; pointer-events: none;
        }
    </style>
</head>
<body>
    <div id="painel">
        <h2>GRAVITY 3D</h2>
        <div class="info">
            Partículas: <span class="valor" id="quantidade">10.000</span><br>
            FPS: <span class="valor" id="fps">0</span><br>
            Gravidade: <span class="valor">Ativa</span><br>
            Dimensão: <span class="valor">3D</span><br>
            Status: <span class="valor" id="status">Executando</span>
        </div>
        <div class="acoes">
            <button id="pausar" type="button">Pausar simulação</button>
            <button id="reiniciar" type="button">Reiniciar</button>
        </div>
    </div>
    <div id="ajuda">
        MOUSE: Girar câmera<br>
        SCROLL: Aproximar / afastar<br>
        ESPAÇO: Pausar / continuar<br>
        R: Reiniciar partículas
    </div>

    <script type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
            "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
        }
    }
    </script>
    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
        import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
        import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
        import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';

        const PARTICULAS = 10000;
        const GRAVIDADE = 180;
        const cena = new THREE.Scene();
        cena.background = new THREE.Color(0x02030a);

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 18, 32);

        const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.25;
        document.body.appendChild(renderer.domElement);

        const controles = new OrbitControls(camera, renderer.domElement);
        controles.enableDamping = true;
        controles.dampingFactor = 0.05;
        controles.minDistance = 5;
        controles.maxDistance = 100;

        cena.add(new THREE.AmbientLight(0x445577, 1.2));
        const luz = new THREE.PointLight(0xffbb44, 100, 100);
        luz.position.set(0, 0, 0);
        cena.add(luz);

        const estrelasGeo = new THREE.BufferGeometry();
        const estrelasPos = new Float32Array(4500 * 3);
        for (let i = 0; i < 4500; i++) {
            const raio = 80 + Math.random() * 40;
            const phi = Math.acos(2 * Math.random() - 1);
            const theta = Math.random() * Math.PI * 2;
            estrelasPos[i * 3] = raio * Math.sin(phi) * Math.cos(theta);
            estrelasPos[i * 3 + 1] = raio * Math.cos(phi);
            estrelasPos[i * 3 + 2] = raio * Math.sin(phi) * Math.sin(theta);
        }
        estrelasGeo.setAttribute('position', new THREE.BufferAttribute(estrelasPos, 3));
        const estrelasMat = new THREE.PointsMaterial({ color: 0x8899cc, size: 0.12, transparent: true, opacity: 0.7 });
        cena.add(new THREE.Points(estrelasGeo, estrelasMat));

        const nucleo = new THREE.Mesh(
            new THREE.SphereGeometry(0.65, 32, 32),
            new THREE.MeshBasicMaterial({ color: 0xffc52e })
        );
        cena.add(nucleo);
        const halo = new THREE.Mesh(
            new THREE.SphereGeometry(1.15, 32, 32),
            new THREE.MeshBasicMaterial({ color: 0xffa500, transparent: true, opacity: 0.12, side: THREE.BackSide })
        );
        cena.add(halo);

        const geometria = new THREE.BufferGeometry();
        const posicoes = new Float32Array(PARTICULAS * 3);
        const velocidade = new Float32Array(PARTICULAS * 3);
        const cores = new Float32Array(PARTICULAS * 3);

        function criarParticulas() {
            for (let i = 0; i < PARTICULAS; i++) {
                const k = i * 3;
                const angulo = Math.random() * Math.PI * 2;
                const raio = 4 + Math.random() * 14;
                const altura = (Math.random() - 0.5) * 3;
                posicoes[k] = Math.cos(angulo) * raio;
                posicoes[k + 1] = altura;
                posicoes[k + 2] = Math.sin(angulo) * raio;

                // Velocidade tangencial aproximada para manter órbitas ao redor do núcleo.
                const velocidadeOrbital = Math.sqrt(GRAVIDADE / raio);
                velocidade[k] = -Math.sin(angulo) * velocidadeOrbital;
                velocidade[k + 1] = (Math.random() - 0.5) * 0.12;
                velocidade[k + 2] = Math.cos(angulo) * velocidadeOrbital;

                const mistura = Math.random();
                cores[k] = 0.45 + mistura * 0.45;
                cores[k + 1] = 0.55 + mistura * 0.4;
                cores[k + 2] = 1.0;
            }
            geometria.setAttribute('position', new THREE.BufferAttribute(posicoes, 3));
            geometria.setAttribute('color', new THREE.BufferAttribute(cores, 3));
            geometria.attributes.position.setUsage(THREE.DynamicDrawUsage);
        }
        criarParticulas();

        const material = new THREE.ShaderMaterial({
            transparent: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            vertexShader: `
                attribute vec3 color;
                varying vec3 vColor;
                void main() {
                    vColor = color;
                    vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
                    gl_PointSize = clamp(65.0 / -mvPosition.z, 1.0, 7.0);
                    gl_Position = projectionMatrix * mvPosition;
                }
            `,
            fragmentShader: `
                varying vec3 vColor;
                void main() {
                    vec2 centro = gl_PointCoord - vec2(0.5);
                    float distancia = length(centro);
                    if (distancia > 0.5) discard;
                    float brilho = exp(-distancia * 12.0);
                    gl_FragColor = vec4(vColor * 1.5, brilho);
                }
            `
        });
        cena.add(new THREE.Points(geometria, material));

        const composer = new EffectComposer(renderer);
        composer.addPass(new RenderPass(cena, camera));
        const bloom = new UnrealBloomPass(
            new THREE.Vector2(window.innerWidth, window.innerHeight), 1.4, 0.5, 0.08
        );
        composer.addPass(bloom);

        let pausado = false;
        let ultimoTempo = 0;
        let frames = 0;
        let tempoFPS = 0;
        const fpsElemento = document.getElementById('fps');
        const statusElemento = document.getElementById('status');
        const botaoPausar = document.getElementById('pausar');

        function atualizarFisica(dt) {
            const suavizacao = 0.8;
            for (let i = 0; i < PARTICULAS; i++) {
                const k = i * 3;
                const x = posicoes[k];
                const y = posicoes[k + 1];
                const z = posicoes[k + 2];
                const distancia2 = x * x + y * y + z * z + suavizacao * suavizacao;
                const inverso = GRAVIDADE / Math.pow(distancia2, 1.5);
                velocidade[k] -= x * inverso * dt;
                velocidade[k + 1] -= y * inverso * dt;
                velocidade[k + 2] -= z * inverso * dt;
                posicoes[k] += velocidade[k] * dt;
                posicoes[k + 1] += velocidade[k + 1] * dt;
                posicoes[k + 2] += velocidade[k + 2] * dt;
            }
            geometria.attributes.position.needsUpdate = true;
        }

        function animar(tempo) {
            requestAnimationFrame(animar);
            const dt = ultimoTempo === 0 ? 0 : Math.min((tempo - ultimoTempo) / 1000, 0.033);
            ultimoTempo = tempo;
            if (!pausado && dt > 0) atualizarFisica(dt);
            nucleo.scale.setScalar(1 + Math.sin(tempo * 0.002) * 0.035);
            halo.scale.setScalar(1 + Math.sin(tempo * 0.0015) * 0.08);
            controles.update();
            composer.render();

            frames++;
            if (tempo - tempoFPS >= 500) {
                fpsElemento.textContent = String(Math.round(frames * 1000 / (tempo - tempoFPS)));
                frames = 0;
                tempoFPS = tempo;
            }
        }

        function alternarPausa() {
            pausado = !pausado;
            statusElemento.textContent = pausado ? 'Pausado' : 'Executando';
            botaoPausar.textContent = pausado ? 'Continuar simulação' : 'Pausar simulação';
        }
        function reiniciar() {
            criarParticulas();
        }
        botaoPausar.addEventListener('click', alternarPausa);
        document.getElementById('reiniciar').addEventListener('click', reiniciar);
        window.addEventListener('keydown', (evento) => {
            if (evento.code === 'Space' && !evento.repeat) {
                evento.preventDefault();
                alternarPausa();
            } else if (evento.key.toLowerCase() === 'r') {
                reiniciar();
            }
        });
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            composer.setSize(window.innerWidth, window.innerHeight);
            bloom.setSize(window.innerWidth, window.innerHeight);
        });

        requestAnimationFrame(animar);
    </script>
</body>
</html>
